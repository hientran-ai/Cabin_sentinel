# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
OPENAI_API_KEY=sk-your-key-here
# Or use other providers:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---- Database ----
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# For SQLite (development):
# DATABASE_URL=sqlite:///./data/app.db

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# CabinSentinel local runtime (backend container uses mosquitto as broker host)
CABINSENTINEL_DB_PATH=data/cabinsentinel.db
CABINSENTINEL_MQTT_ENABLED=false
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MODEL_PATH=
MODEL_CONFIDENCE=0.25
# Optional adult/child classifier checkpoint (Tâm's best.pt, kept outside Git). Empty = disabled:
# people are reported with age_group "unknown". Never assumed adult.
AGE_CLASSIFIER_PATH=
AGE_CHILD_THRESHOLD=0.5
AGE_ADULT_THRESHOLD=0.9
MAX_UPLOAD_SIZE_BYTES=5242880
MAX_IMAGE_PIXELS=20000000
MAX_CONCURRENT_DEMO_REQUESTS=1
# Add your exact Vercel deployment origin here for the online demo.
# CORS_ORIGINS=https://your-frontend.vercel.app

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=<get-your-api-key-from-dashboard-phoenix>
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Camera / privacy / fleet (local demo; see docs/DEMO ... and scripts/run_backend.sh) ---
# YuNet face model (checksum verified on load; never downloaded at inference time)
FACE_MODEL_PATH=models/face_detection_yunet_2023mar.onnx
# Device credential for sensor/vision ingest (scripts/run_backend.sh generates one into data/.device-token)
# CABINSENTINEL_DEVICE_TOKEN=
# Dev-only owner/admin role login; always disabled when APP_ENV=production
CABINSENTINEL_DEMO_LOGIN=true
# Optional JSON fleet definition; default is 4 simulated demo vehicles
# CABINSENTINEL_FLEET_FILE=
# Local frontend origins for CORS (no wildcard in production)
# CORS_ORIGINS=http://127.0.0.1:5183,http://localhost:5183

# --- Platform API (accounts, commands, evidence) ---
# PLATFORM_SIGNING_KEY=<long random string>   # signs evidence URLs; random per process if unset
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com     # created at startup if missing
# BOOTSTRAP_ADMIN_PASSWORD=<12+ chars>
# ALLOW_SIGNUP=false                          # default: open outside production, closed in production
# REMOTE_COMMANDS_ENABLED=false               # default: on outside production, off in production
# COOKIE_SAMESITE=lax                         # none only for a cross-site SPA (forces Secure)
# EVIDENCE_RETENTION_HOURS=72

# ---- V1 end-to-end demo (see docs/OEM_E2E_V1_RUNBOOK.md) ----
# Demo sessions (telemetry, observations as detections only, events) are deleted after this many hours without updates.
DEMO_RETENTION_HOURS=24
MAX_UPLOAD_SIZE_BYTES=5242880
MAX_CONCURRENT_DEMO_REQUESTS=1
