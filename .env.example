# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
OPENAI_API_KEY=sk-your-key-here
# Or use other providers:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---- Database ----
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# For SQLite (development):
# DATABASE_URL=sqlite:///./data/app.db

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# CabinSentinel local runtime (backend container uses mosquitto as broker host)
CABINSENTINEL_DB_PATH=data/cabinsentinel.db
CABINSENTINEL_MQTT_ENABLED=false
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MODEL_PATH=
MODEL_CONFIDENCE=0.25
MAX_UPLOAD_SIZE_BYTES=5242880
MAX_IMAGE_PIXELS=20000000
MAX_CONCURRENT_DEMO_REQUESTS=1
# Add your exact Vercel deployment origin here for the online demo.
# CORS_ORIGINS=https://your-frontend.vercel.app

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=<get-your-api-key-from-dashboard-phoenix>
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
