{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cabinsentinel",
  "main": "./workers/frontend-router.js",
  "compatibility_date": "2026-10-03",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/", "/login", "/user", "/user/login", "/app", "/signin", "/sign-in", "/api/*", "/health", "/admin", "/admin/*"]
  },
  "vars": {
    "BACKEND_ORIGIN": "https://khanh3636-backend-p068.hf.space",
    "MOBILE_APP_URL": "https://cabin-noir.duckdns.org/app/"
  }
}
