{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cabinsentinel",
  "main": "./workers/frontend-router.js",
  "compatibility_date": "2026-10-03",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health", "/admin", "/admin/*"]
  },
  "vars": {
    "BACKEND_ORIGIN": "https://khanh3636-backend-p068.hf.space"
  }
}
