# Frontend build variables (Vite). None of these is a secret: they are embedded in the public bundle.
# Leave VITE_API_BASE empty to call /api on the same origin (the Cloudflare Worker proxies it to the backend).
VITE_API_BASE=
# Real device camera frames contain real faces. Keep false for any hosted demo (COMPLIANCE DP-03, DP-07).
# Laptop camera: on automatically on localhost; set true to allow it on a hosted build (DP-03), false to disable everywhere.
# VITE_ENABLE_DEVICE_CAMERA=true
