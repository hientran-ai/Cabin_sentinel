# Copy to backend/.env and fill in. Never commit the real file.
CABIN_ENV=production

# Where data lives (SQLite). Back this file up.
CABIN_DB=/data/cabinsentinel.db
CABIN_MEDIA=/data/media

# Sign-in codes. Use SMS (recommended) ...
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# ... or, for one family running their own server, push the code to ONE private admin topic you subscribe to in ntfy.
OTP_NTFY_TOPIC=

# Push notifications to phones (ntfy). ntfy.sh works out of the box; self-host for full privacy.
NTFY_URL=https://ntfy.sh
NTFY_TOKEN=

# Outside temperature (°C) at or above which an occupied parked car is treated as dangerous when there is no cabin sensor.
CABIN_HOT_OUTSIDE_C=28
CABIN_TOKEN_TTL_DAYS=90

# Telegram notifications (optional). Create a bot with @BotFather. Leave TELEGRAM_WEBHOOK_SECRET empty to use polling.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Public address of the web app, for the "Mở Cabin Noir" button in Telegram messages.
WEB_BASE_URL=
